+  // 1D textures wider than the host maximum, used by games as data tables
+  // (5345084C looks up per-object colors from the vertex shader, point-sampled
+  // with unnormalized coordinates). No host texture exists for them, so read
+  // the texel from the shared memory. Only unsigned k_8_8_8_8 with no swizzle or
+  // exponent bias is handled; D3D12CommandProcessor reports anything else.
+  bool wide_1d_possible = instr.opcode == FetchOpcode::kTextureFetch &&
+                          instr.dimension == xenos::FetchOpDimension::k1D &&
+                          instr.attributes.unnormalized_coordinates;
+  if (wide_1d_possible) {
+    uint32_t wide_temp = PushSystemTemp();
+    a_.OpUBFE(dxbc::Dest::R(wide_temp, 0b0001), dxbc::Src::LU(24), dxbc::Src::LU(0),
+              RequestTextureFetchConstantWord(tfetch_index, 2));
+    a_.OpUGE(dxbc::Dest::R(wide_temp, 0b0010), dxbc::Src::R(wide_temp, dxbc::Src::kXXXX),
+             dxbc::Src::LU(xenos::kTexture2DCubeMaxWidthHeight));
+    a_.OpIf(true, dxbc::Src::R(wide_temp, dxbc::Src::kYYYY));
+    {
+      bool coord_operand_temp_pushed = false;
+      dxbc::Src coord_operand =
+          LoadOperand(instr.operands[0], 0b0001, coord_operand_temp_pushed).SelectFromSwizzled(0);
+      a_.OpAdd(dxbc::Dest::R(wide_temp, 0b0010), coord_operand,
+               dxbc::Src::LF(instr.attributes.offset_x));
+      if (coord_operand_temp_pushed) {
+        PopSystemTemp();
+      }
+    }
+    // Clamp the texel index to the table, then make the byte address.
+    a_.OpRoundNI(dxbc::Dest::R(wide_temp, 0b0010), dxbc::Src::R(wide_temp, dxbc::Src::kYYYY));
+    a_.OpFToI(dxbc::Dest::R(wide_temp, 0b0010), dxbc::Src::R(wide_temp, dxbc::Src::kYYYY));
+    a_.OpIMax(dxbc::Dest::R(wide_temp, 0b0010), dxbc::Src::R(wide_temp, dxbc::Src::kYYYY),
+              dxbc::Src::LI(0));
+    a_.OpUMin(dxbc::Dest::R(wide_temp, 0b0010), dxbc::Src::R(wide_temp, dxbc::Src::kYYYY),
+              dxbc::Src::R(wide_temp, dxbc::Src::kXXXX));
+    a_.OpAnd(dxbc::Dest::R(wide_temp, 0b0001), RequestTextureFetchConstantWord(tfetch_index, 1),
+             dxbc::Src::LU(~uint32_t(0xFFF)));
+    a_.OpIMAd(dxbc::Dest::R(wide_temp, 0b0001), dxbc::Src::R(wide_temp, dxbc::Src::kYYYY),
+              dxbc::Src::LU(sizeof(uint32_t)), dxbc::Src::R(wide_temp, dxbc::Src::kXXXX));
+    // The shared memory may be bound as an SRV or a UAV, as in vfetch.
+    a_.OpAnd(dxbc::Dest::R(system_temp_result_, 0b0001), LoadFlagsSystemConstant(),
+             dxbc::Src::LU(kSysFlag_SharedMemoryIsUAV));
+    a_.OpIf(false, dxbc::Src::R(system_temp_result_, dxbc::Src::kXXXX));
+    if (srv_index_shared_memory_ == kBindingIndexUnallocated) {
+      srv_index_shared_memory_ = srv_count_++;
+    }
+    if (uav_index_shared_memory_ == kBindingIndexUnallocated) {
+      uav_index_shared_memory_ = uav_count_++;
+    }
+    a_.OpLdRaw(dxbc::Dest::R(system_temp_result_, 0b0001),
+               dxbc::Src::R(wide_temp, dxbc::Src::kXXXX),
+               dxbc::Src::T(srv_index_shared_memory_, uint32_t(SRVMainRegister::kSharedMemory)));
+    a_.OpElse();
+    a_.OpLdRaw(dxbc::Dest::R(system_temp_result_, 0b0001),
+               dxbc::Src::R(wide_temp, dxbc::Src::kXXXX),
+               dxbc::Src::U(uav_index_shared_memory_, uint32_t(UAVRegister::kSharedMemory)));
+    a_.OpEndIf();
+    // Unpack k_8_8_8_8 to 0...1.
+    a_.OpUBFE(dxbc::Dest::R(system_temp_result_), dxbc::Src::LU(8), dxbc::Src::LU(0, 8, 16, 24),
+              dxbc::Src::R(system_temp_result_, dxbc::Src::kXXXX));
+    a_.OpUToF(dxbc::Dest::R(system_temp_result_), dxbc::Src::R(system_temp_result_));
+    a_.OpMul(dxbc::Dest::R(system_temp_result_), dxbc::Src::R(system_temp_result_),
+             dxbc::Src::LF(1.0f / 255.0f));
+    StoreResult(instr.result, dxbc::Src::R(system_temp_result_));
+    a_.OpElse();
+    // Release wide_temp.
+    PopSystemTemp();
+  }
